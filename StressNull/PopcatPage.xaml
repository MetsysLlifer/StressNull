<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StressNull.PopcatPage"
             Title="Popcat">

    <VerticalStackLayout Spacing="25" Padding="30" VerticalOptions="Center">
        
        <Label Text="POPCAT" 
               FontSize="32" 
               FontAttributes="Bold" 
               HorizontalOptions="Center" />

        <Label x:Name="ScoreLabel"
               Text="0" 
               FontSize="67" 
               FontAttributes="Bold" 
               HorizontalOptions="Center" />

        <ImageButton x:Name="PopcatImage"
                     Source="popcat_closed.svg"
                     HeightRequest="300"
                     WidthRequest="300"
                     HorizontalOptions="Center"
                     Pressed="OnPopcatPressed"
                     Released="OnPopcatReleased" />
        
        <Label Text="Tap to relieve stress!" 
               FontSize="18" 
               HorizontalOptions="Center" />
    </VerticalStackLayout>
</ContentPage>