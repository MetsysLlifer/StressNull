<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StressNull.RegisterPage"
             Title="Register"
             BackgroundColor="#F5F5F5">

    <ScrollView>
        <VerticalStackLayout Spacing="25" Padding="30,50" VerticalOptions="Center">
            
            <Label Text="Create an Account" 
                   FontSize="28" FontAttributes="Bold" TextColor="#512BD4"
                   HorizontalOptions="Center" />

            <Frame BackgroundColor="White" Padding="20" CornerRadius="12" HasShadow="True" BorderColor="LightGray">
                <VerticalStackLayout Spacing="15">
                    
                    <Entry x:Name="UsernameEntry" 
                           Placeholder="Username" 
                           TextColor="Black"
                           PlaceholderColor="Gray"
                           Keyboard="Text" />
                    
                    <Entry x:Name="PasswordEntry" 
                           Placeholder="Password (min 6 chars)" 
                           IsPassword="True" 
                           TextColor="Black"
                           PlaceholderColor="Gray" />
                           
                    <Label x:Name="ErrorLabel" 
                           TextColor="Red" 
                           IsVisible="False" 
                           HorizontalOptions="Center" />
                           
                    <Label x:Name="SuccessLabel" 
                           TextColor="Green" 
                           IsVisible="False" 
                           HorizontalOptions="Center" />

                    <Button Text="Register" 
                            Clicked="OnRegisterClicked" 
                            BackgroundColor="#512BD4" 
                            TextColor="White" 
                            FontAttributes="Bold" 
                            CornerRadius="10" />
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>