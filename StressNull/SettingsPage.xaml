<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StressNull.SettingsPage"
             Title="Settings">
    
    <VerticalStackLayout Padding="30" Spacing="25">
        
        <VerticalStackLayout Spacing="5">
            <Label Text="Master Volume (Amplifier)" FontSize="18" FontAttributes="Bold" />
            <Slider x:Name="MasterVolumeSlider" Minimum="0" Maximum="2" ValueChanged="OnVolumeChanged" />
        </VerticalStackLayout>

        <VerticalStackLayout Spacing="5">
            <Label Text="Music" FontSize="18" FontAttributes="Bold" />
            <Slider x:Name="MusicVolumeSlider" Minimum="0" Maximum="1" ValueChanged="OnVolumeChanged" />
        </VerticalStackLayout>

        <VerticalStackLayout Spacing="5">
            <Label Text="Sound Effects (SFX)" FontSize="18" FontAttributes="Bold" />
            <Slider x:Name="SfxVolumeSlider" Minimum="0" Maximum="1" ValueChanged="OnVolumeChanged" />
        </VerticalStackLayout>

    </VerticalStackLayout>
</ContentPage>