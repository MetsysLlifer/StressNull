<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StressNull.BrainrotPage"
             Title="Brainrot Swipe"
             BackgroundColor="White">

    <Grid RowDefinitions="Auto, *, Auto">
        <!-- Top Stats -->
        <HorizontalStackLayout Grid.Row="0" Spacing="20" HorizontalOptions="Center" Padding="10">
            <Label Text="DOPAMINE:" TextColor="DarkGreen" FontAttributes="Bold" VerticalOptions="Center"/>
            <ProgressBar x:Name="DopamineBar" Progress="0.1" WidthRequest="200" ProgressColor="Lime" VerticalOptions="Center"/>
        </HorizontalStackLayout>

        <!-- Card Stack -->
        <Grid Grid.Row="1" x:Name="CardContainer" HorizontalOptions="Fill" VerticalOptions="Fill" Margin="40">
            <!-- Cards will be added here programmatically -->
        </Grid>

        <!-- Bottom Text -->
        <VerticalStackLayout Grid.Row="2" Padding="20" HorizontalOptions="Center" Spacing="10">
            <Label x:Name="ScoreLabel" Text="MEMES CONSUMED: 0" TextColor="Black" FontSize="18" HorizontalOptions="Center"/>
            <Label Text="THROW CARDS ANYWHERE FOR BRAINROT" TextColor="Gray" FontSize="12" HorizontalOptions="Center"/>
        </VerticalStackLayout>
    </Grid>
</ContentPage>